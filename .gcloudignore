# Cloud Build ignore file
# Similar to .gitignore but for gcloud deployments

# Dependencies
node_modules/
frontend/node_modules/

# Build outputs (will be generated in Docker)
dist/
frontend/dist/

# Environment files (secrets managed separately)
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test files
*.test.ts
*.spec.ts
__tests__/
coverage/

# Documentation (not needed in container)
*.md
!README.md

# Frontend (deployed separately to Vercel)
frontend/

# Local development
.railway/
railway.toml
